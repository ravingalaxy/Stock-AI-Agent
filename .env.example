# ==============================================================================
# AI Stock Market Research & Ranking Agent - Environment Configuration
# Copy this file to `.env` or `config/.env` and update values as needed.
# ==============================================================================

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-ai-stock-agent-nse-bse-quant-key-2026-production-ready
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# AI / LLM Provider (Optional - FreeLLM API or OpenAI or Local Ollama)
# FreeLLM API (Recommended unified endpoint)
FREELLM_API_KEY=your_freellmapi_key_here
FREELLM_API_BASE=https://api.freellmapi.com/v1

# OpenAI API Settings (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Local Ollama Settings (Optional, when provider=ollama in config/config.yaml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# Custom Paid Market Data / Broker API Keys (Optional - yfinance is the default free provider)
NSE_API_KEY=
BSE_API_KEY=
FINANCIAL_DATA_PROVIDER_KEY=

# Database & Storage
DATABASE_URL=sqlite:///data/stock_research.db
VECTOR_DB_DIR=data/chroma_db

# Logging
LOG_LEVEL=INFO
