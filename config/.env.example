# AI Stock Agent Environment Configuration

# freellmapi (Unified API) - RECOMMENDED
FREELLM_API_KEY=your_freellmapi_key_here
FREELLM_API_BASE=https://api.freellmapi.com/v1

# OpenAI API Settings (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Local Ollama Settings (Optional, when provider=ollama in config.yaml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# Custom Paid Market Data / Broker API Keys (Optional - yfinance is default)
NSE_API_KEY=
BSE_API_KEY=
FINANCIAL_DATA_PROVIDER_KEY=

# Database Settings
DATABASE_URL=sqlite:///data/stock_research.db
VECTOR_DB_DIR=data/chroma_db

# Logging & Debug
LOG_LEVEL=INFO
